ZYBOOKS_EMAIL=student@example.com
ZYBOOKS_PASSWORD=replace-me
ZYBOOKAUTO_SECRET=replace-with-a-random-secret
ZYBOOKAUTO_DB=zybookauto.db
PORT=8765

# Required for the network-reachable MCP endpoint.
ZYBOOKAUTO_MCP_TOKEN=replace-with-a-long-random-token
# Set this to the actual URL your agent will use, for example:
# ZYBOOKAUTO_MCP_PUBLIC_URL=http://192.168.1.25:20030/mcp
ZYBOOKAUTO_MCP_PUBLIC_URL=http://localhost:20030/mcp
